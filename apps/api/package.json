    "mammoth": "1.10.0",
    "openai": "7.15.0",
    "pdf-parse": "2.4.5",
    "sharp": "0.34.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
