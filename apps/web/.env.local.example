# apps/web frontend environment.
# The canonical environment file lives at the repository root; these are the
# VITE_-prefixed values the browser bundle needs. Copy to .env.local.
#
# NOTHING HERE IS REQUIRED. With no .env.local at all, MAINHAUS renders a real map of
# Frankfurt using MapLibre over OpenStreetMap-derived tiles, and address search uses the
# OpenStreetMap Nominatim geocoder. Both are keyless.

# --- Map ---------------------------------------------------------------------
# OPTIONAL. Setting this switches the map to the Google Maps JavaScript API, which is
# the brief's primary path and the only path permitted to render Google Places content.
# The key is intentionally public but MUST be restricted by HTTP referrer and limited to
# the Maps JavaScript API. Leave it blank to use the keyless MapLibre map.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# OPTIONAL. Google Maps Map ID for cloud styling / Advanced Markers. Only used when a
# browser key is set. Defaults to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=

# OPTIONAL. MapLibre style URL for the keyless path. Defaults to OpenFreeMap, which
# serves OpenStreetMap-derived vector tiles with no API key. Point this at your own style
# or a provider you hold a licence for if you prefer. If the vector style cannot load,
# the app falls back to OpenStreetMap raster tiles automatically.
VITE_MAP_STYLE_URL=

# --- Transport ---------------------------------------------------------------
# "mock" (labelled sample data, no server needed), "live" (calls /api), or "auto".
# "auto" probes /api/health once and falls back to mock if nothing answers.
VITE_API_TRANSPORT=auto

# Where `vite dev` proxies /api. Must match the Fastify port in apps/api.
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
