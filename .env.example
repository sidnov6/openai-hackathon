# MAINHAUS runs truthfully in limited local mode without external credentials.
PORT=8787
HOST=127.0.0.1
DEMO_MODE=true
DATABASE_PATH=./data/mainhaus.sqlite
UPLOAD_DIR=./data/uploads
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_ADMIN_TOKEN=replace-for-shared-demos

# Set both values to enable AI-assisted full-document analysis. The model name is
# intentionally not guessed; use a model enabled for your OpenAI project.
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEYS=
GROQ_MODEL=

# Google keys are intentionally split. Restrict the browser key by referrer and
# the server key by API. Secrets must never use a VITE_ prefix.
GOOGLE_MAPS_SERVER_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY=

# mock = labelled saved discovery, live = API, auto = API with honest fallback.
VITE_API_TRANSPORT=auto
